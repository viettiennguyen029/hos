# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=

# Blockchain escrow payment -- custodial wallet key encryption. Must
# decode (base64) to exactly 32 bytes. See
# docs/superpowers/specs/2026-08-10-blockchain-escrow-payment-design.md
# and .claude/rules/env-secrets.md.
# Generate with: openssl rand -base64 32
WALLET_MASTER_KEY=

# Blockchain escrow payment -- chain connectivity and gas sponsorship.
AVALANCHE_RPC_URL=
AVALANCHE_NETWORK=fuji
FORWARDER_ADDRESS=
# Bearer token Vercel Cron must present to trigger /api/cron/check-relayer-balance.
CRON_SECRET=

# Blockchain escrow payment -- escrow contracts and pricing.
ESCROW_MANAGER_ADDRESS=
SETTLEMENT_TOKEN_ADDRESS=
# Must match the settlement token's own EIP-712 domain version (commonly
# "1" or "2" depending on the token -- e.g. "1" for this repo's MockERC20
# test fixture).
SETTLEMENT_TOKEN_PERMIT_VERSION=
VND_PER_USDT=
