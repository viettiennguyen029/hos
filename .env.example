# Supabase -- dev project (cqnrunwprjjrdzxntpol). URL is public by
# design (ships to the browser); anon key is also safe client-side
# (RLS-gated) but not filled in here -- get it from Supabase dashboard
# -> Project Settings -> API. Service role key is a real secret, never
# put it in this file for real -- only ever in a local, gitignored .env.
NEXT_PUBLIC_SUPABASE_URL=https://cqnrunwprjjrdzxntpol.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=

# Blockchain escrow payment -- custodial wallet key encryption. Must
# decode (base64) to exactly 32 bytes. See
# docs/superpowers/specs/2026-08-10-blockchain-escrow-payment-design.md
# and .claude/rules/env-secrets.md.
# Generate with: openssl rand -base64 32
WALLET_MASTER_KEY=

# Blockchain escrow payment -- chain connectivity and gas sponsorship.
# RPC/network/addresses below are Avalanche Fuji testnet (chainId
# 43113) public info, not secrets. Explorer: https://testnet.snowtrace.io/
AVALANCHE_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
AVALANCHE_NETWORK=fuji
# ERC2771Forwarder deployed 2026-08-11 alongside the EscrowManager proxy
# below -- reuse this on every future deploy (don't deploy a new one),
# so existing organizer/talent meta-tx signatures stay valid.
FORWARDER_ADDRESS=0x936d6f6FBbEBf8Db24e7dEDD37A0F77D4eC609f0
# Bearer token Vercel Cron must present to trigger /api/cron/check-relayer-balance
# and /api/cron/poll-escrow-events. Not a real secret value here -- generate your own.
CRON_SECRET=

# Blockchain escrow payment -- escrow contracts and pricing.
# EscrowManager UUPS proxy deployed to Fuji 2026-08-11 via
# contracts/scripts/deploy.ts (see contracts/.openzeppelin/avalanche-fuji.json
# for the upgrade-safety manifest).
ESCROW_MANAGER_ADDRESS=0x43Ce77962af1a02cf1789a12Ea9EC58b29A7d55d
# Fuji testnet USDC (EIP-2612 permit-capable -- verified empirically:
# name()="USD Coin", decimals()=6, and a real signed permit() via this
# repo's signPermit() was submitted and accepted on-chain).
SETTLEMENT_TOKEN_ADDRESS=0x5425890298aed601595a70AB815c96711a31Bc65
# Verified empirically against the token above (its own version() call
# returns "2", and a real permit() signed with tokenVersion: "2" via
# this repo's signPermit() was accepted on-chain) -- not just trusted
# from version(), since this token's DOMAIN_SEPARATOR() doesn't match a
# naively-recomputed hash (likely a cached-vs-live chainid quirk in its
# EIP712 base). For a different settlement token, re-verify the same
# way rather than assuming "1" or "2". This repo's MockERC20 test
# fixture also uses "1" (OpenZeppelin ERC20Permit's default).
SETTLEMENT_TOKEN_PERMIT_VERSION=2
# 1 USD = 26000 VND (2026-08-11).
VND_PER_USDT=26000
